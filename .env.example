WHATSAPP_API_URL=https://graph.facebook.com/vXX.X/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=tender_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Required for cloud deployments. The portal will require this username and password.
APP_USERNAME=
APP_PASSWORD=
# Cloud deployments fail closed when HOST=0.0.0.0. Keep this set to 1 in Railway.
REQUIRE_AUTH=0
SOURCE_TIMEOUT_SECONDS=45
SOURCE_RETRIES=2
COLLECTOR_WORKERS=8
AUTO_COLLECT_INTERVAL_MINUTES=60
# Set to 0 only if individual notice pages are too slow to check for published dates.
NOTICE_PAGE_DATE_LOOKUPS=1

# Cloud hosting only. Leave HOST at 127.0.0.1 for a private local server.
HOST=127.0.0.1
# Set this to your provider's persistent disk mount path, for example /opt/render/project/src/storage.
DATA_DIR=
