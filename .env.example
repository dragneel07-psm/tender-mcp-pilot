WHATSAPP_API_URL=https://graph.facebook.com/vXX.X/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT=
WHATSAPP_TEMPLATE_NAME=tender_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Required for cloud deployments. The portal will require this username and password.
APP_USERNAME=
APP_PASSWORD=
# Cloud deployments fail closed when HOST=0.0.0.0. Keep this set to 1 in Railway.
REQUIRE_AUTH=0
SOURCE_TIMEOUT_SECONDS=45
SOURCE_RETRIES=2
# Concurrent fetches per collection cycle. This is I/O-bound (waiting on sockets, not CPU),
# so it's safe to raise well above the CPU count -- each worker hits a different government
# site, so raising this does not increase load on any single site. With a large source list,
# a low value here is the main reason a full sweep can run far longer than AUTO_COLLECT_INTERVAL_MINUTES.
COLLECTOR_WORKERS=8
AUTO_COLLECT_INTERVAL_MINUTES=60
# After this many consecutive failures, a source is skipped on scheduled sweeps (not on a
# manual/single-source collect) until SOURCE_FAILURE_SKIP_COOLDOWN_MINUTES has passed since its
# last attempt. Keeps chronically dead sites from eating a full timeout*retries budget every cycle.
SOURCE_FAILURE_SKIP_THRESHOLD=5
SOURCE_FAILURE_SKIP_COOLDOWN_MINUTES=360
# Set to 0 only if individual notice pages are too slow to check for published dates.
NOTICE_PAGE_DATE_LOOKUPS=1
# Per source per cycle: at most this many notices without a listing-page date get a supplementary
# per-notice-page lookup, run this many at a time, each bounded to this timeout with no retries
# (best-effort -- a notice that misses its lookup just keeps its "collected" date this cycle).
# Keeps a handful of slow/dead notice pages on one source from stalling an entire collection cycle.
NOTICE_PAGE_LOOKUP_LIMIT=15
NOTICE_PAGE_LOOKUP_WORKERS=5
NOTICE_PAGE_LOOKUP_TIMEOUT_SECONDS=15
# Off by default. When on, genuinely new notices (never previously-seen ones) get their linked
# PDF document(s) downloaded and text-extracted, feeding notices.submission_deadline and the new
# documents table / GET /notices/{id}/documents. Bounded per source per cycle by the three
# settings below so a burst of new notices can't blow up a cycle's duration.
DOCUMENT_PROCESSING_ENABLED=0
DOCUMENT_DOWNLOAD_LIMIT=3
DOCUMENT_DOWNLOAD_WORKERS=3
DOCUMENT_MAX_SIZE_BYTES=15728640
DOCUMENT_DOWNLOAD_TIMEOUT_SECONDS=20
# How many days before a known submission_deadline the scheduler sends one reminder alert for a
# notice (never repeats -- see deliveries.reason='deadline_reminder'). No effect while
# DOCUMENT_PROCESSING_ENABLED=0, since submission_deadline stays null until that's on.
DEADLINE_REMINDER_DAYS=3

# Off by default, and only reachable when DOCUMENT_PROCESSING_ENABLED=1 (it extracts from
# documents.extracted_text). Strictly optional -- collection, search, and alerts all keep working
# with zero AI configured. Set AI_PROVIDER to a key in tender_monitor/ai.py's PROVIDERS ("anthropic"
# is the only one today) and that provider's API key to turn this on. Each extraction is a real,
# paid LLM API call, so AI_EXTRACTION_LIMIT bounds how many run per source per cycle.
AI_EXTRACTION_ENABLED=0
AI_PROVIDER=
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_EXTRACTION_LIMIT=3

# Cloud hosting only. Leave HOST at 127.0.0.1 for a private local server.
HOST=127.0.0.1
# Set this to your provider's persistent disk mount path, for example /opt/render/project/src/storage.
DATA_DIR=
