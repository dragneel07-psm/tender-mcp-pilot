{
  "rewrites": [
    { "source": "/sources/:path*", "destination": "/api/sources/:path*" },
    { "source": "/watchlists/:path*", "destination": "/api/watchlists/:path*" },
    { "source": "/alerts/:path*", "destination": "/api/alerts/:path*" },
    { "source": "/notices/:path*", "destination": "/api/notices/:path*" },
    { "source": "/health", "destination": "/api/health" },
    { "source": "/source/:path*", "destination": "/dashboard.html" },
    { "source": "/", "destination": "/dashboard.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'" }
      ]
    }
  ]
}
